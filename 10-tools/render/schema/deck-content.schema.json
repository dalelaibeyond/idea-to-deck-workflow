{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://idea-to-deck.local/schema/deck-content.schema.json",
  "title": "deck-content.md machine contract (A4 spec v1)",
  "description": "Two subschemas: 'frontmatter' validates the file-level YAML block; 'slide' validates each per-slide fenced block. The archetype enum mirrors design.schema.json; design.md layout_tag_vocab remains the single authority and is asserted at compile time.",
  "type": "object",
  "definitions": {
    "nonempty": { "type": "string", "minLength": 1 },
    "bullets": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/definitions/nonempty" }
    },
    "archetype_name": {
      "type": "string",
      "enum": [
        "HERO_CENTER",
        "SPLIT_50_50",
        "METRIC_HERO_ROW",
        "CARD_ROW_3",
        "GRID_2X2",
        "PROCESS_TIMELINE"
      ]
    },
    "frontmatter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_slides", "audience", "core_objective"],
      "properties": {
        "total_slides": { "type": "integer", "minimum": 1 },
        "audience": { "$ref": "#/definitions/nonempty" },
        "core_objective": { "$ref": "#/definitions/nonempty" },
        "scenario": { "$ref": "#/definitions/nonempty" },
        "language": { "$ref": "#/definitions/nonempty" }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "action_title", "args", "voiceover", "mindset"],
      "properties": {
        "layout": { "$ref": "#/definitions/archetype_name" },
        "action_title": { "$ref": "#/definitions/nonempty" },
        "args": { "type": "object" },
        "voiceover": { "$ref": "#/definitions/nonempty" },
        "mindset": { "$ref": "#/definitions/nonempty" }
      },
      "allOf": [
        {
          "if": { "properties": { "layout": { "const": "HERO_CENTER" } } },
          "then": { "properties": { "args": { "$ref": "#/definitions/args_HERO_CENTER" } } }
        },
        {
          "if": { "properties": { "layout": { "const": "SPLIT_50_50" } } },
          "then": { "properties": { "args": { "$ref": "#/definitions/args_SPLIT_50_50" } } }
        },
        {
          "if": { "properties": { "layout": { "const": "METRIC_HERO_ROW" } } },
          "then": { "properties": { "args": { "$ref": "#/definitions/args_METRIC_HERO_ROW" } } }
        },
        {
          "if": { "properties": { "layout": { "const": "CARD_ROW_3" } } },
          "then": { "properties": { "args": { "$ref": "#/definitions/args_CARD_ROW_3" } } }
        },
        {
          "if": { "properties": { "layout": { "const": "GRID_2X2" } } },
          "then": { "properties": { "args": { "$ref": "#/definitions/args_GRID_2X2" } } }
        },
        {
          "if": { "properties": { "layout": { "const": "PROCESS_TIMELINE" } } },
          "then": { "properties": { "args": { "$ref": "#/definitions/args_PROCESS_TIMELINE" } } }
        }
      ]
    },
    "args_HERO_CENTER": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kicker", "subtitle", "takeaway", "meta"],
      "properties": {
        "kicker": { "$ref": "#/definitions/nonempty" },
        "subtitle": { "$ref": "#/definitions/nonempty" },
        "takeaway": { "$ref": "#/definitions/nonempty" },
        "meta": { "$ref": "#/definitions/nonempty" }
      }
    },
    "args_SPLIT_50_50": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_anchor", "right_bullets"],
      "properties": {
        "left_anchor": { "$ref": "#/definitions/nonempty" },
        "right_bullets": { "$ref": "#/definitions/bullets" }
      }
    },
    "args_METRIC_HERO_ROW": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics"],
      "properties": {
        "metrics": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "label", "context"],
            "properties": {
              "number": { "$ref": "#/definitions/nonempty" },
              "label": { "$ref": "#/definitions/nonempty" },
              "context": { "$ref": "#/definitions/nonempty" }
            }
          }
        }
      }
    },
    "args_CARD_ROW_3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cards"],
      "properties": {
        "cards": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["header", "bullets"],
            "properties": {
              "header": { "$ref": "#/definitions/nonempty" },
              "bullets": { "$ref": "#/definitions/bullets" }
            }
          }
        }
      }
    },
    "args_GRID_2X2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quadrants"],
      "properties": {
        "quadrants": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "bullets"],
            "properties": {
              "title": { "$ref": "#/definitions/nonempty" },
              "bullets": { "$ref": "#/definitions/bullets" }
            }
          }
        }
      }
    },
    "args_PROCESS_TIMELINE": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array", "minItems": 3, "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["header", "summary"],
            "properties": {
              "header": { "$ref": "#/definitions/nonempty" },
              "summary": { "$ref": "#/definitions/nonempty" }
            }
          }
        }
      }
    }
  }
}
